{
  "name": "citynovus",
  "version": "0.1.0",
  "private": true,
  "description": "citynovus.com — India builds its own 3D map. Colour in your city, block by block.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "fetch-osm": "node scripts/fetch-osm.mjs",
    "server": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.3",
    "maplibre-gl": "^5.24.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.170.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
