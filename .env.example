# ---- browser (Vite reads VITE_* at build time) ----
# local  = everything stays in this browser
# server = talk to the Township API
# auto   = use the API if one answers at /api, else local   (default)
VITE_BACKEND=auto
# Leave empty when the API serves the site (same origin). Set for a separate static host.
VITE_API_URL=
# Basemap style. OpenFreeMap needs no key. Any MapLibre style JSON URL works.
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# Points needed to flag in local mode (production uses FLAG_MIN_POINTS below).
VITE_FLAG_MIN_POINTS=1000

# ---- server (npm run server) ----
PORT=8080
# Empty = embedded PGlite in ./data. On DigitalOcean paste the Managed Postgres connection string.
DATABASE_URL=
# true in production: only logged-in accounts can build. Guests can still explore.
REQUIRE_LOGIN=false
FLAG_MIN_POINTS=1000
# true when served over https
COOKIE_SECURE=false
SESSION_DAYS=90
# true in production together with REQUIRE_LOGIN: accounts must click the email link before building.
REQUIRE_VERIFIED=false
# Where the app is reachable; used in verification and reset emails.
PUBLIC_URL=http://localhost:8080
# SMTP for verification and reset mails, e.g. smtps://user:pass@smtp.example.com:465 . Empty = print to the log.
SMTP_URL=
MAIL_FROM=Township <no-reply@township.so>
# Sign-in. Register <PUBLIC_URL>/api/auth/google/callback as a redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# google | password | google,password
AUTH_METHODS=google
# Outside production only: fake the Google callback so sign-in can be tested without credentials.
GOOGLE_MOCK=false
# Hours a guest's unsaved work survives.
PROVISIONAL_TTL_HOURS=24
# Long random string. Opens /admin. Empty = admin off.
ADMIN_TOKEN=
# Abuse limits
RATE_LIMIT_PER_IP_PER_MIN=300
SIGNUPS_PER_IP_PER_DAY=5
# Uploaded photos and the embedded database live here (a volume in Docker).
DATA_DIR=./data
